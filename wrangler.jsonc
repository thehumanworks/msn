{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "msn",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-11",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [{ "pattern": "msn.thehuman.sh", "custom_domain": true }],
  "vars": {
    "ACCESS_AUD": "fc4fca07af05bc0cc24884f638d0226e82a213de16e695fe089a3c52896c71a4",
    "ACCESS_TEAM_DOMAIN": "nothumanlabs.cloudflareaccess.com",
    "ACCESS_LOGIN_URL": "https://msn.thehuman.sh/login"
  },
  "migrations": [{ "new_sqlite_classes": ["MsnDurableObject"], "tag": "v1" }],
  "durable_objects": {
    "bindings": [{ "class_name": "MsnDurableObject", "name": "MSN_DURABLE_OBJECT" }]
  },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "secrets": { "required": ["ADMIN_TOKEN"] },
  "observability": { "enabled": true },
  "upload_source_maps": true
}
