{
  "name": "msn",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "cf-typegen": "wrangler types",
    "onboarding-check": "node scripts/onboarding-check.mjs",
    "test": "vitest run && node --test tests/cli.test.mjs tests/onboarding-check.test.mjs tests/event-runner.test.mjs tests/host-*.test.mjs tests/agent-runner.test.mjs tests/push-sw.test.mjs",
    "test:participants": "cargo build --manifest-path cli/Cargo.toml --locked && node tests/participants.integration.mjs",
    "test:swarm": "cargo build --manifest-path cli/Cargo.toml --locked && node tests/swarm.integration.mjs",
    "test:browser": "cargo build --manifest-path cli/Cargo.toml --locked && playwright test --config tests/playwright.config.mjs",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run lint && bun run test && bun run test:browser",
    "msn": "node scripts/msn.mjs",
    "test:critical": "cargo build --manifest-path cli/Cargo.toml --locked && node tests/critical.integration.mjs",
    "test:transfer": "cargo build --manifest-path cli/Cargo.toml --locked && node tests/transfer.integration.mjs",
    "events:run": "node scripts/event-runner.mjs",
    "test:events": "node --test tests/event-runner.test.mjs",
    "test:dispatch": "cargo build --manifest-path cli/Cargo.toml --locked && node tests/event-dispatch.integration.mjs",
    "host": "node scripts/host-runner.mjs",
    "test:host": "node --test tests/host-*.test.mjs",
    "test:host:integration": "node tests/host.integration.mjs",
    "test:board": "cargo build --manifest-path cli/Cargo.toml --locked && node tests/board.integration.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@cloudflare/vitest-plugin": "^1.1.9",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "typescript": "^5.5.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.131.2"
  },
  "dependencies": {
    "jose": "^6.2.12"
  }
}
