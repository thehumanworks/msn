{
  "name": "msn",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "cf-typegen": "wrangler types",
    "test": "vitest run && node --test tests/cli.test.mjs",
    "test:browser": "playwright test --config tests/playwright.config.mjs",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run lint && bun run test && bun run test:browser",
    "msn": "node scripts/msn.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@cloudflare/vitest-plugin": "^1.1.9",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "typescript": "^5.5.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.131.2"
  }
}
