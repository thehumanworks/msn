{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "files": {
    "includes": [
      "src/**",
      "public/**",
      "scripts/**",
      "tests/**",
      "packages/**",
      "*.json",
      "*.jsonc",
      "vitest.config.ts",
      "!scripts/.secrets",
      "!worker-configuration.d.ts",
      "!tests/fixtures/task-projection.json",
      "!package-lock.json",
      "!.pi",
      "!target",
      "!cli/target",
      "!**/target",
      "!!node_modules",
      "!!.wrangler"
    ]
  },
  "formatter": { "indentStyle": "space", "lineWidth": 110 },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } }
}
